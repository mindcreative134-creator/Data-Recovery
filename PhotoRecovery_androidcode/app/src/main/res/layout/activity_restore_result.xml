<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_banner_gradient">

    <!-- Decorative Circles -->
    <View android:layout_width="200dp" android:layout_height="200dp"
        android:layout_alignParentTop="true" android:layout_alignParentEnd="true"
        android:layout_marginTop="-70dp" android:layout_marginEnd="-70dp"
        android:background="@drawable/bg_circle_white_alpha" android:importantForAccessibility="no"/>
    <View android:layout_width="140dp" android:layout_height="140dp"
        android:layout_alignParentBottom="true" android:layout_alignParentStart="true"
        android:layout_marginBottom="-50dp" android:layout_marginStart="-50dp"
        android:background="@drawable/bg_circle_white_alpha" android:importantForAccessibility="no"/>

    <LinearLayout
        android:id="@+id/view_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- SUCCESS ANIMATION -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/img_done"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/ic_cub" />

        <!-- SUCCESS CARD (dark glass) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <!-- Teal checkmark icon -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_circle_purple"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔"
                        android:textSize="32sp"
                        android:textColor="@color/colorSecondary"/>
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restored Successfully!"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <!-- File count -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 Files Restored"
                    android:textColor="@color/colorSecondary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/md_grey_100" android:layout_marginBottom="12dp"/>

                <!-- Path Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved to:"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <!-- Path -->
                <TextView
                    android:id="@+id/tvPath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/storage/RestoredPhotos"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- NO ADS on success screen — policy compliant -->

</RelativeLayout>
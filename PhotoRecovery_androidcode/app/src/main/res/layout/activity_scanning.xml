<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scan_screen"
    android:fitsSystemWindows="true"
    tools:context=".activity.ScanningActivity">

    <!-- ===== TOP APP BAR ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Scanning..."
            app:titleTextAppearance="@style/ScanToolbarTitle"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/colorPrimaryLight" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== MAIN CONTENT ===== -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appbar"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <!-- ===== HERO TITLE SECTION ===== -->
        <LinearLayout
            android:id="@+id/titleLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanning Device"
                android:textColor="@color/colorTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please wait while we find deleted files..."
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ===== LIVE COUNT CARDS ROW ===== -->
        <LinearLayout
            android:id="@+id/ll_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4"
            android:layout_marginBottom="20dp">

            <!-- Photos Count Card -->
            <LinearLayout
                android:id="@+id/cardPhotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_photos"
                android:padding="12dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_images"
                    android:tint="@color/white"/>

                <TextView
                    android:id="@+id/noOfImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photos"
                    android:textColor="#FFD0E8"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <!-- Videos Count Card -->
            <LinearLayout
                android:id="@+id/cardVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_videos"
                android:padding="12dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_videos"
                    android:tint="@color/white"/>

                <TextView
                    android:id="@+id/noOfVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Videos"
                    android:textColor="#FFD0D0"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <!-- Audios Count Card -->
            <LinearLayout
                android:id="@+id/cardAudios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_audios"
                android:padding="12dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_audio"
                    android:tint="@color/white"/>

                <TextView
                    android:id="@+id/noOfAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audios"
                    android:textColor="#FFE8C0"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <!-- Others Count Card -->
            <LinearLayout
                android:id="@+id/cardOthers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_others"
                android:padding="12dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_others"
                    android:tint="@color/white"/>

                <TextView
                    android:id="@+id/noOfOthers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Others"
                    android:textColor="#C0E8FF"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== RADAR ANIMATION AREA ===== -->
        <FrameLayout
            android:id="@+id/radarContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Radar Ring 1 (outermost — slowest pulse) -->
            <View
                android:id="@+id/radarRing1"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_ring"
                android:alpha="0.15"/>

            <!-- Radar Ring 2 -->
            <View
                android:id="@+id/radarRing2"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_ring"
                android:alpha="0.25"/>

            <!-- Radar Ring 3 -->
            <View
                android:id="@+id/radarRing3"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_ring"
                android:alpha="0.45"/>

            <!-- Radar Ring 4 (innermost) -->
            <View
                android:id="@+id/radarRing4"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_ring"
                android:alpha="0.70"/>

            <!-- Lottie radar animation on top -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation_view"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/redar1" />

            <!-- Center glow dot -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_center"/>

        </FrameLayout>

        <!-- ===== STATUS PILL BADGE (Bottom) ===== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_scan_status_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <!-- Glowing pulsing dot -->
            <View
                android:id="@+id/pulseDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_pulse_dot"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep Scanning Storage..."
                android:textColor="@color/colorPrimaryLight"
                android:textSize="13sp"
                android:textStyle="italic"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

    </LinearLayout>

    <!-- NO BANNER AD on scanning screen — policy compliant -->

</RelativeLayout>
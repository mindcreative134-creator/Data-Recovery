<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_glass_card"
    android:layout_marginBottom="8dp">

    <!-- Glowing Category Circle Icon -->
    <LinearLayout
        android:id="@+id/iconCircle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="@drawable/bg_icon_circle_purple"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/imgType"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_cat_others"
            android:tint="@color/white"/>
    </LinearLayout>

    <!-- File Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/storage/emulated/0/DCIM"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Right Side Actions/Status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.2 MB"
            android:textColor="@color/colorPrimaryLight"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- Error Reason pill for unrecoverable items -->
        <TextView
            android:id="@+id/tvErrorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overwritten"
            android:textColor="@color/colorVideos"
            android:background="#22FF4D4D"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>

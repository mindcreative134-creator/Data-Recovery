<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".activity.MainActivity">

    <!-- ===== TOP TOOLBAR (Dark Premium) ===== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        android:elevation="0dp"
        app:title="Data Recovery Pro"
        app:titleTextColor="@color/colorTextPrimary"
        app:navigationIcon="@drawable/ic_menu"
        app:navigationIconTint="@color/colorTextPrimary"
        app:menu="@menu/toolbar_menu"/>

    <!-- ===== SCROLL CONTENT ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolBar"
        android:layout_above="@id/bottomNavBar"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- ===== SMART RECOVERY HERO BANNER CARD ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/recycling"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginBottom="20dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_gradient">

                    <!-- Decorative large circle -->
                    <View
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginEnd="-40dp"
                        android:layout_marginTop="-40dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:importantForAccessibility="no"/>

                    <!-- Decorative small circle -->
                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="55dp"
                        android:layout_marginBottom="-20dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:importantForAccessibility="no"/>

                    <!-- Banner text + button (left side) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="22dp"
                        android:orientation="vertical">

                        <!-- PRO label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SMART RECOVERY"
                            android:textColor="#AACCFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data Recovery"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:layout_width="210dp"
                            android:layout_height="wrap_content"
                            android:text="Recover deleted photos, videos,\naudios &amp; files easily"
                            android:textColor="#CCE0FF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"/>

                        <!-- Start Scan Button -->
                        <TextView
                            android:id="@+id/startBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_start_scan_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingHorizontal="22dp"
                            android:text="  Start Scan  ›"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== SECTION TITLE ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recover By Category"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>

            <!-- ===== CATEGORY GRID ROW 1 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:weightSum="2">

                <!-- IMAGES CARD (glassmorphism dark) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:id="@+id/allImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Pink gradient circle icon -->
                        <LinearLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:background="@drawable/bg_card_photos">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_cat_images"
                                android:tint="@color/white"/>
                        </LinearLayout>

                        <View android:layout_width="0dp" android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Images"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/totalImage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 Files"
                                    android:textColor="@color/colorTextHint"
                                    android:textSize="11sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle_pink">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                    android:src="@drawable/ic_chevron_right_small"
                                    android:tint="@color/colorPhotos"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- VIDEOS CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:id="@+id/allVideos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:background="@drawable/bg_card_videos">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/ic_cat_videos"
                                android:tint="@color/white"/>
                        </LinearLayout>

                        <View android:layout_width="0dp" android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Videos" android:textColor="@color/colorTextPrimary"
                                    android:textSize="14sp" android:textStyle="bold"/>
                                <TextView android:id="@+id/totalVideo"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0 Files" android:textColor="@color/colorTextHint" android:textSize="11sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="26dp" android:layout_height="26dp"
                                android:gravity="center" android:background="@drawable/bg_icon_circle_red">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                    android:src="@drawable/ic_chevron_right_small" android:tint="@color/colorVideos"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== CATEGORY GRID ROW 2 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:weightSum="2">

                <!-- AUDIO CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:id="@+id/allAudios"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout android:layout_width="52dp" android:layout_height="52dp"
                            android:gravity="center" android:background="@drawable/bg_card_audios">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/ic_cat_audio"
                                android:tint="@color/white"/>
                        </LinearLayout>

                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Audio" android:textColor="@color/colorTextPrimary"
                                    android:textSize="14sp" android:textStyle="bold"/>
                                <TextView android:id="@+id/totalAudio"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0 Files" android:textColor="@color/colorTextHint" android:textSize="11sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="26dp" android:layout_height="26dp"
                                android:gravity="center" android:background="@drawable/bg_icon_circle_orange">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                    android:src="@drawable/ic_chevron_right_small" android:tint="@color/colorAudios"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- OTHERS CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="135dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:id="@+id/allOthers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout android:layout_width="52dp" android:layout_height="52dp"
                            android:gravity="center" android:background="@drawable/bg_card_others">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/ic_cat_others"
                                android:tint="@color/white"/>
                        </LinearLayout>

                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Other Files" android:textColor="@color/colorTextPrimary"
                                    android:textSize="14sp" android:textStyle="bold"/>
                                <TextView android:id="@+id/totalOther"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0 Files" android:textColor="@color/colorTextHint" android:textSize="11sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="26dp" android:layout_height="26dp"
                                android:gravity="center" android:background="@drawable/bg_icon_circle_blue">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                    android:src="@drawable/ic_chevron_right_small" android:tint="@color/colorOthers"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== 100% SAFE CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:background="@drawable/bg_icon_circle_purple"
                        android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_shield_check"
                            android:tint="@color/colorPrimary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="100% Safe &amp; Secure"
                            android:textColor="@color/colorTextPrimary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="We respect your privacy and keep your data safe."
                            android:textColor="@color/colorTextSecondary" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM NAVIGATION BAR (Dark) ===== -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_above="@id/adsView"
        android:orientation="horizontal"
        android:background="@color/colorNavBackground"
        android:elevation="8dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_home" android:tint="@color/colorNavActive"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textColor="@color/colorNavActive" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecovered"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_recovered" android:tint="@color/colorNavInactive"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Recovered" android:textColor="@color/colorNavInactive" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrash"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_trash" android:tint="@color/colorNavInactive"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Trash" android:textColor="@color/colorNavInactive" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_settings" android:tint="@color/colorNavInactive"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Settings" android:textColor="@color/colorNavInactive" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== BANNER AD (policy-compliant: at bottom, on interactive screen) ===== -->
    <FrameLayout
        android:id="@+id/adsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorNavBackground"/>

</RelativeLayout>